WG_DIR = "/etc/wireguard"
WG_NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,14}$")


def wg_confs():
    out = {}
    for fn in sorted(os.listdir(WG_DIR)):
        if not fn.endswith(".conf"):
            continue
        name = fn[:-5]
        if not WG_NAME.match(name):
            continue
        iface, peers, cur, comment = {}, [], None, ""
        for raw in open(os.path.join(WG_DIR, fn)):
            line = raw.strip()
            if line.startswith("#"):
                comment = line.lstrip("# ").strip()
                continue
            if line == "[Interface]":
                cur = iface
                continue
            if line == "[Peer]":
                cur = {"comment": comment}
                peers.append(cur)
                comment = ""
                continue
            if "=" in line and cur is not None:
                k, _, v = line.partition("=")
                k = k.strip()
                if k in ("PrivateKey", "PresharedKey", "PostUp", "PostDown", "PreUp", "PreDown"):
                    if k.startswith(("Post", "Pre")):
                        cur["hooks"] = cur.get("hooks", 0) + 1
                        cur.setdefault("hook_lines", []).append("%s = %s" % (k, v.strip()))
                    continue
                cur[k] = v.strip()
        out[name] = {"iface": iface, "peers": peers}
    return out


def wg_runtime():
    rt = {}
    for line in sh("wg", "show", "all", "dump", check=False).splitlines():
        f = line.split("\t")
        if len(f) == 5:
            rt.setdefault(f[0], {"listen": f[3], "pub": f[2], "peers": {}})
        elif len(f) == 9:
            rt.setdefault(f[0], {"peers": {}})["peers"][f[1]] = {
                "endpoint": None if f[3] == "(none)" else f[3], "allowed": f[4],
                "handshake": int(f[5]) or None, "rx": int(f[6]), "tx": int(f[7]),
                "keepalive": None if f[8] == "off" else f[8]}
    return rt


def systemd_state(name):
    en = subprocess.run(["systemctl", "is-enabled", "wg-quick@" + name], capture_output=True, text=True).stdout.strip()
    return en == "enabled"


def cmd_wg():
    confs, rt = wg_confs(), wg_runtime()
    out = []
    for name, c in confs.items():
        r = rt.get(name)
        peers = []
        for p in c["peers"]:
            live = (r or {}).get("peers", {}).get(p.get("PublicKey", ""), {})
            peers.append({"pub": p.get("PublicKey"), "comment": p.get("comment"), "allowed": p.get("AllowedIPs"),
                          "endpoint": live.get("endpoint") or p.get("Endpoint"), "keepalive": p.get("PersistentKeepalive"),
                          "handshake": live.get("handshake"), "rx": live.get("rx"), "tx": live.get("tx")})
        out.append({"name": name, "active": r is not None, "autostart": systemd_state(name), "created": _created_here(name),
                    "has_client": os.path.exists(os.path.join(CLIENT_DIR, name + ".conf")),
                    "address": c["iface"].get("Address"), "port": c["iface"].get("ListenPort"),
                    "pub": (r or {}).get("pub"), "hooks": c["iface"].get("hooks", 0),
                    "hook_lines": c["iface"].get("hook_lines", []), "peers": peers})
    print(json.dumps({"tunnels": out, "time": int(time.time()),
                      "defaults": {"home_routes": HOME_ROUTES, "dns": CFG["dns"], "tun_net": str(TUN_NET),
                                   "ports": "%d-%d" % (PORTS.start, PORTS.stop - 1)}}))


def _wg_check(name):
    if not WG_NAME.match(name or "") or not os.path.exists(os.path.join(WG_DIR, name + ".conf")):
        raise ValueError("Tunnel %s gibt es nicht" % name)


def cmd_wg_up(name):
    _wg_check(name)
    confs, rt = wg_confs(), wg_runtime()
    me = confs[name]["iface"]
    for other, c in confs.items():
        if other == name or other not in rt:
            continue
        if me.get("ListenPort") and me.get("ListenPort") == c["iface"].get("ListenPort"):
            raise ValueError("Port %s nutzt schon der aktive Tunnel %s" % (me["ListenPort"], other))
        if me.get("Address") and me.get("Address") == c["iface"].get("Address"):
            raise ValueError("Adresse %s nutzt schon der aktive Tunnel %s" % (me["Address"], other))
    sh("systemctl", "start", "wg-quick@" + name)
    print(json.dumps({"ok": True}))


def cmd_wg_down(name):
    _wg_check(name)
    sh("systemctl", "stop", "wg-quick@" + name)
    # tunnels brought up by hand (wg-quick up) are not stopped by systemd
    if wg_runtime().get(name):
        sh("wg-quick", "down", name)
    print(json.dumps({"ok": True}))


def cmd_wg_autostart(name, on):
    _wg_check(name)
    sh("systemctl", "enable" if on == "on" else "disable", "wg-quick@" + name)
    print(json.dumps({"ok": True}))


CLIENT_DIR = os.path.join(WG_DIR, "netdash-clients")
MARK = "# netdash:"
TUN_NET = ipaddress.ip_network(CFG["wg_net"])
_p = [int(x) for x in str(CFG["wg_ports"]).split("-")]
PORTS = range(_p[0], (_p[1] if len(_p) > 1 else _p[0]) + 1)
HOME_ROUTES = CFG["home_routes"] or ", ".join(CFG["home_nets"])
TUN_FIRST = ipaddress.ip_address(CFG["wg_first"]) if CFG["wg_first"] else TUN_NET.network_address


def _created_here(name):
    try:
        return open(os.path.join(WG_DIR, name + ".conf")).readline().startswith(MARK)
    except OSError:
        return False


def _used_space():
    nets, ports = [], set()
    for fn in os.listdir(WG_DIR):
        if not fn.endswith(".conf"):
            continue
        for raw in open(os.path.join(WG_DIR, fn)):
            k, _, v = raw.partition("=")
            k = k.strip()
            if k in ("Address", "AllowedIPs"):
                for part in v.split(","):
                    try:
                        n = ipaddress.ip_interface(part.strip()).network
                    except ValueError:
                        continue
                    if n.version == 4 and n.overlaps(TUN_NET):
                        nets.append(n)
            elif k == "ListenPort" and v.strip().isdigit():
                ports.add(int(v.strip()))
    ports |= {p for proto, p in listeners() if proto == "udp"}
    return nets, ports


def cmd_wg_create(name, route, dns):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,11}", name or ""):
        raise ValueError("Name: a-z, 0-9 und -, höchstens 12 Zeichen")
    iface = "wg-" + name
    if os.path.exists(os.path.join(WG_DIR, iface + ".conf")):
        raise ValueError("Tunnel %s gibt es schon" % iface)
    nets, ports = _used_space()
    block = next((b for b in TUN_NET.subnets(new_prefix=30)
                  if int(b.network_address) >= int(TUN_FIRST) and not any(b.overlaps(n) for n in nets)), None)
    port = next((p for p in PORTS if p not in ports), None)
    if not block or not port:
        raise ValueError("Kein freies Netz oder kein freier Port mehr")
    hosts = list(block.hosts())
    srv_ip, cli_ip = hosts[0], hosts[1]
    gen = lambda: sh("wg", "genkey").strip()
    pub = lambda k: sh("wg", "pubkey", inp=k + "\n").strip()
    srv_priv, cli_priv, psk = gen(), gen(), sh("wg", "genpsk").strip()
    srv_pub, cli_pub = pub(srv_priv), pub(cli_priv)
    stamp = time.strftime("%Y-%m-%d %H:%M")
    server = "\n".join([
        "%s erstellt %s vom Netzwerk-Dashboard (%s)" % (MARK, stamp, name),
        "[Interface]",
        "Address = %s/30" % srv_ip,
        "ListenPort = %d" % port,
        "PrivateKey = %s" % srv_priv,
        "PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -A FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT",
        "PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -D FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT",
        "",
        "# %s" % name,
        "[Peer]",
        "PublicKey = %s" % cli_pub,
        "PresharedKey = %s" % psk,
        "AllowedIPs = %s/32" % cli_ip,
        ""])
    allowed = "0.0.0.0/0, ::/0" if route == "all" else "%s, %s" % (HOME_ROUTES, TUN_NET)
    client = "\n".join([
        "# WireGuard %s · %s · erstellt %s" % (name, CFG["name"], stamp),
        "[Interface]",
        "PrivateKey = %s" % cli_priv,
        "Address = %s/32" % cli_ip,
        *(["DNS = %s" % CFG["dns"]] if dns == "adguard" and CFG["dns"] else []),
        "",
        "[Peer]",
        "PublicKey = %s" % srv_pub,
        "PresharedKey = %s" % psk,
        "Endpoint = %s:%d" % (WAN_IP, port),
        "AllowedIPs = %s" % allowed,
        "PersistentKeepalive = 25",
        ""])
    old = os.umask(0o077)
    try:
        os.makedirs(CLIENT_DIR, exist_ok=True)
        with open(os.path.join(WG_DIR, iface + ".conf"), "w") as f:
            f.write(server)
        with open(os.path.join(CLIENT_DIR, iface + ".conf"), "w") as f:
            f.write(client)
    finally:
        os.umask(old)
    sh("systemctl", "enable", "--now", "wg-quick@" + iface)
    print(json.dumps({"ok": True, "name": iface, "port": port, "address": str(cli_ip), "config": client}))


def cmd_wg_config(name):
    _wg_check(name)
    path = os.path.join(CLIENT_DIR, name + ".conf")
    if not os.path.exists(path):
        raise ValueError("Für %s gibt es keine gespeicherte Client-Konfiguration (nicht vom Dashboard angelegt)" % name)
