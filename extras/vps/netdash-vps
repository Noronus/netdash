        elif n.startswith("wt"):
            kind, label = "netbird", "NetBird"
        elif n.startswith("wg"):
            kind, label = "wireguard", "WireGuard " + (n[3:] if n.startswith("wg-") else n)
        elif n.startswith("br-") or n == "docker0":
            kind, label = "docker", "Docker · " + nets.get(n, n)
        elif x.get("link_type") == "ether":
            kind, label = "public", "Internet (öffentlich)"
        else:
            kind, label = "other", n
        st = x.get("stats64") or {}
        out.append({"name": n, "kind": kind, "label": label, "state": x.get("operstate"), "mtu": x.get("mtu"),
                    "addrs": ["%s/%s" % (a["local"], a["prefixlen"]) for a in x.get("addr_info", [])
                              if not a["local"].startswith("fe80")],
                    "rx": st.get("rx", {}).get("bytes", 0), "tx": st.get("tx", {}).get("bytes", 0),
                    "rx_drop": st.get("rx", {}).get("dropped", 0), "tx_drop": st.get("tx", {}).get("dropped", 0)})
    print(json.dumps({"t": time.time(), "ifaces": out}))


def main(argv):
    os.environ["TZ"] = "Europe/Berlin"
    time.tzset()
    if argv and argv[0] == "--ssh":
        argv = (os.environ.get("SSH_ORIGINAL_COMMAND") or "").split()
    if not argv:
        print(__doc__)
        return 1
    c, rest = argv[0], argv[1:]
    try:
        if c == "status":
            cmd_status()
        elif c == "apply":
            cmd_apply()
        elif c == "confirm":
            cmd_confirm()
        elif c == "rollback":
            cmd_rollback()
        elif c == "boot":
            cmd_boot()
        elif c == "test" and len(rest) == 2:
            cmd_test(*rest)
        elif c == "ifaces":
            cmd_ifaces()
        elif c == "wg":
            cmd_wg()
        elif c == "wg-up" and len(rest) == 1:
            cmd_wg_up(rest[0])
            fw_refresh()
        elif c == "wg-down" and len(rest) == 1:
            cmd_wg_down(rest[0])
        elif c == "wg-autostart" and len(rest) == 2 and rest[1] in ("on", "off"):
            cmd_wg_autostart(*rest)
        elif c == "wg-create" and len(rest) == 3 and rest[1] in ("home", "all") and rest[2] in ("adguard", "none"):
            cmd_wg_create(*rest)
            fw_refresh()
        elif c == "wg-config" and len(rest) == 1:
            cmd_wg_config(rest[0])
        elif c == "wg-delete" and len(rest) == 1:
            cmd_wg_delete(rest[0])
            fw_refresh()
        elif c == "wg-edit" and len(rest) == 1:
            cmd_wg_edit(rest[0])
            fw_refresh()
        elif c == "fw-status":
            cmd_fw_status()
        elif c == "fw-apply":
            cmd_fw_apply()
        elif c == "fw-refresh":
            cmd_fw_refresh()
        elif c == "fw-confirm":
            cmd_fw_confirm()
        elif c == "fw-rollback":
            cmd_fw_rollback()
        else:
            print(json.dumps({"error": "unknown command"}))
            return 2
    except (ValueError, RuntimeError) as e:
        print(json.dumps({"error": str(e)}))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
