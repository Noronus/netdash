def cmd_wg_delete(name):
    _wg_check(name)
    if not _created_here(name):
        raise ValueError("%s wurde nicht vom Dashboard angelegt und wird hier nicht gelöscht" % name)
    subprocess.run(["systemctl", "disable", "--now", "wg-quick@" + name], capture_output=True)
    if wg_runtime().get(name):
        sh("wg-quick", "down", name, check=False)
    arch = os.path.join(WG_DIR, "archiv")
    os.makedirs(arch, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    os.replace(os.path.join(WG_DIR, name + ".conf"), os.path.join(arch, "%s.conf.%s" % (name, stamp)))
    cpath = os.path.join(CLIENT_DIR, name + ".conf")
    if os.path.exists(cpath):
        os.replace(cpath, os.path.join(arch, "%s.client.conf.%s" % (name, stamp)))
    print(json.dumps({"ok": True}))


def _sections(text):
    """config text -> (lines before the first section, [{"head", "lead": comment lines above it, "body"}])"""
    pre, secs, cur = [], [], None
    for line in text.splitlines():
        if line.strip() in ("[Interface]", "[Peer]"):
            src = cur["body"] if cur else pre
            lead = []
            while src and src[-1].strip().startswith("#"):
                lead.insert(0, src.pop())
            cur = {"head": line.strip(), "lead": lead, "body": []}
            secs.append(cur)
        elif cur is None:
            pre.append(line)
        else:
            cur["body"].append(line)
    return pre, secs


def _key_of(line):
    s = line.strip()
    return s.split("=", 1)[0].strip() if "=" in s and not s.startswith("#") else None


def _set(body, key, val):
    idx = [i for i, ln in enumerate(body) if _key_of(ln) == key]
    for i in reversed(idx[1:] if val else idx):
        del body[i]
    if not val:
        return
    if idx:
        body[idx[0]] = "%s = %s" % (key, val)
    else:
        last = max([i for i, ln in enumerate(body) if ln.strip()] or [-1])
        body.insert(last + 1, "%s = %s" % (key, val))


def _nets(v, what, iface=False):
    out = []
    for part in str(v or "").replace("\n", ",").split(","):
        part = part.strip()
        if not part:
            continue
        try:
            out.append(str(ipaddress.ip_interface(part)) if iface else str(ipaddress.ip_network(part, strict=False)))
        except ValueError:
            raise ValueError("%s: %s ist keine gültige Adresse" % (what, part))
    return ", ".join(out)


def cmd_wg_edit(name):
    _wg_check(name)
    ch = json.loads(sys.stdin.read() or "{}")
    path = os.path.join(WG_DIR, name + ".conf")
    text = open(path).read()
    pre, secs = _sections(text)
    iface = next((x for x in secs if x["head"] == "[Interface]"), None)
    if not iface:
        raise ValueError("%s hat keinen [Interface]-Abschnitt" % name)
    confs, rt = wg_confs(), wg_runtime()
    if "address" in ch:
        addr = _nets(ch["address"], "Adresse", iface=True)
        if not addr:
            raise ValueError("Adresse fehlt")
        _set(iface["body"], "Address", addr)
    if "port" in ch:
        port = str(ch["port"] or "").strip()
        if port and not (port.isdigit() and 1 <= int(port) <= 65535):
            raise ValueError("Port: 1 bis 65535")
        _set(iface["body"], "ListenPort", port)
    for pc in ch.get("peers") or []:
        sec = next((x for x in secs if x["head"] == "[Peer]" and
                    any(_key_of(ln) == "PublicKey" and ln.split("=", 1)[1].strip() == pc.get("pub") for ln in x["body"])), None)
        if not sec:
            raise ValueError("Peer %s… gibt es nicht mehr" % str(pc.get("pub"))[:8])
        if "comment" in pc:
            c = re.sub(r"[\r\n]+", " ", str(pc["comment"] or "")).strip()[:60]
            if sec["lead"] and not sec["lead"][-1].startswith(MARK):
                sec["lead"].pop()
            if c:
                sec["lead"].append("# " + c)
        if "allowed" in pc:
            allowed = _nets(pc["allowed"], "AllowedIPs")
            if not allowed:
                raise ValueError("AllowedIPs darf nicht leer sein")
            _set(sec["body"], "AllowedIPs", allowed)
        if "keepalive" in pc:
            ka = str(pc["keepalive"] or "").strip()
            if ka and not (ka.isdigit() and int(ka) <= 65535):
                raise ValueError("Keepalive: Sekunden, 0 bis 65535")
            _set(sec["body"], "PersistentKeepalive", "" if ka in ("", "0") else ka)
    out = pre + [ln for x in secs for ln in x["lead"] + [x["head"]] + x["body"]]
    new = "\n".join(out).rstrip("\n") + "\n"
    if new == text:
        print(json.dumps({"ok": True, "changed": False}))
        return
    # an active tunnel must not take the port or address of another active one
    me = {}
    for ln in new.splitlines():
        k = _key_of(ln)
        if k in ("ListenPort", "Address") and k not in me:
            me[k] = ln.split("=", 1)[1].strip()
    if name in rt:
        for other, c in confs.items():
            if other == name or other not in rt:
                continue
            if me.get("ListenPort") and me["ListenPort"] == (c["iface"].get("ListenPort") or "").strip():
                raise ValueError("Port %s nutzt schon der aktive Tunnel %s" % (me["ListenPort"], other))
            if me.get("Address") and me["Address"] == c["iface"].get("Address"):
                raise ValueError("Adresse %s nutzt schon der aktive Tunnel %s" % (me["Address"], other))
    arch = os.path.join(WG_DIR, "archiv")
    os.makedirs(arch, exist_ok=True)
    backup = os.path.join(arch, "%s.conf.%s-edit" % (name, time.strftime("%Y%m%d-%H%M%S")))
    old = os.umask(0o077)
    try:
        with open(backup, "w") as f:
            f.write(text)
        # wg-quick only parses files named <interface>.conf: check a copy in a private temp dir
        tdir = tempfile.mkdtemp(prefix="netdash-wg-")
        try:
            tmp = os.path.join(tdir, name + ".conf")
            with open(tmp, "w") as f:
                f.write(new)
            p = subprocess.run(["wg-quick", "strip", tmp], capture_output=True, text=True)
        finally:
            shutil.rmtree(tdir, ignore_errors=True)
        if p.returncode != 0:
            raise ValueError("Konfiguration ungültig: %s" % (p.stderr or p.stdout).strip()[:200])
        with open(path, "w") as f:   # in place: keeps owner and mode
            f.write(new)
    finally:
        os.umask(old)
    restarted = False
    if name in rt:
        def restart():
            subprocess.run(["systemctl", "stop", "wg-quick@" + name], capture_output=True)
            if wg_runtime().get(name):
                subprocess.run(["wg-quick", "down", name], capture_output=True)
            return subprocess.run(["systemctl", "start", "wg-quick@" + name], capture_output=True, text=True)
        p = restart()
        if p.returncode != 0:
            err = (p.stderr or p.stdout).strip()
            with open(path, "w") as f:   # keeps the file mode (600)
                f.write(text)
            restart()
            raise RuntimeError("Tunnel startet mit der neuen Konfiguration nicht, alte wiederhergestellt: %s" % err[:200])
        restarted = True
    print(json.dumps({"ok": True, "changed": True, "restarted": restarted, "backup": backup}))


def cmd_ifaces():
    links = json.loads(sh("ip", "-j", "-s", "addr", "show"))
    nets = {}
    try:
        for ln in sh("docker", "network", "ls", "--no-trunc", "--format", "{{.ID}}\t{{.Name}}", check=False).splitlines():
            nid, _, nname = ln.partition("\t")
